{
  "manifest_version": 3,
  "name": "Sticky Notes Sync",
  "version": "1.0.0",
  "description": "Quick formatted notes in folders, synced to a Google Sheet in your own Drive.",
  "action": {
    "default_title": "Sticky Notes Sync",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "identity", "clipboardWrite"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://sheets.googleapis.com/*",
    "https://openidconnect.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ]
}
